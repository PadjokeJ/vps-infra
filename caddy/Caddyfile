https://rythmo.padjokej.dev {
	reverse_proxy /* http://rythmo:8080 {
		header_up Host {host}
		transport http {
			read_timeout 120s
			write_timeout 120s
		}
	}
}

https://epfl.cc, https://www.epfl.cc, https://go.epfl.cc, https://isa.epfl.cc, https://edu.epfl.cc, https://people.epfl.cc, https://moodle.epfl.cc {
  @browser {
    header_regexp browser User-Agent Mozilla.*
    path /*
  }

  @nb {
      not header_regexp browser User-Agent Mozilla.*
  }
  root /srv
  file_server @browser {
  
  }
  handle_errors {
    rewrite /index.html
    file_server
  }
  redir @nb https://{labels.2}.{labels.1}.ch{uri}
}

